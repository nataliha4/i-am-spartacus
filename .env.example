DATABASE_URL=postgres://spartacus:spartacus@localhost:5433/spartacus
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:5173
PORT=3000
DB_POOL_MAX=5
DB_SSL=disable
# DB_SSL=require verifies the server certificate. Optional private CA:
# DB_SSL_CA_FILE=/run/secrets/postgres-ca.crt
# TRUST_PROXY=false
# Required when TRUST_PROXY=true; use only actual ingress IPs/CIDRs:
# TRUSTED_PROXY_CIDRS=10.42.1.0/24
# Google OAuth Web application; see GOOGLE_AUTH_SETUP.md. Runtime secrets only.
# Leave BOTH unset until configured (Google sign-in returns 503).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Required before enabling Google signup in production; also used by policy pages.
OPERATOR_NAME=
PRIVACY_CONTACT=
# Set these to the ACTUAL infrastructure retention periods (0 means none).
BACKUP_RETENTION_DAYS=
LOG_RETENTION_DAYS=
