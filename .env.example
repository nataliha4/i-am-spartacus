DATABASE_URL=postgres://spartacus:spartacus@localhost:5433/spartacus
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:5173
PORT=3000
DB_POOL_MAX=5
DB_SSL=disable
# DB_SSL=require verifies the server certificate. Optional private CA:
# DB_SSL_CA_FILE=/run/secrets/postgres-ca.crt
# TRUST_PROXY=false
# Required when TRUST_PROXY=true; use only actual ingress IPs/CIDRs:
# TRUSTED_PROXY_CIDRS=10.42.1.0/24
