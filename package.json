{
  "name": "i-am-spartacus",
  "version": "1.0.0",
  "description": "My Daily Tracker for Health and Activity \u2014 a simple personal health and wellness tracking app",
  "type": "module",
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "start": "bun dist/server/index.js",
    "build": "vite build && bun build src/server/index.ts --target=bun --packages=external --outdir=dist/server",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test": "bun test tests/unit",
    "test:integration": "bun test --timeout 30000 tests/integration",
    "test:components": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:status": "bun scripts/migrate.ts status",
    "db:migrate": "bun scripts/migrate.ts apply",
    "account:create": "bun scripts/accounts.ts create",
    "account:reset": "bun scripts/accounts.ts reset",
    "account:google": "bun scripts/accounts.ts google",
    "account:revoke": "bun scripts/accounts.ts revoke",
    "test:images": "bun scripts/smoke-images.ts",
    "db:prune": "bun scripts/prune.ts"
  },
  "keywords": [
    "tracker",
    "health",
    "wellness",
    "fasting"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "bun": "1.4.2"
  },
  "dependencies": {
    "@better-auth/core": "1.7.4",
    "@js-temporal/polyfill": "0.5.1",
    "better-auth": "1.7.4",
    "drizzle-orm": "0.45.2",
    "hono": "4.13.7",
    "postgres": "3.4.9",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@tanstack/react-query": "5.102.8",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/bun": "1.4.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "chart.js": "4.5.1",
    "drizzle-kit": "0.31.10",
    "eslint": "10.10.0",
    "globals": "17.12.0",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "5.0.0"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    }
  }
}
